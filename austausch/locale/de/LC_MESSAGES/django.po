#: austausch/models.py:389
msgid "Upload Thumbnail Enabled"
msgstr "Thumbnail-Upload aktiviert"

#: austausch/models.py:390
msgid ""
"If enabled, upload video cover/thumbnail images from a local directory when "
"exporting to server."
